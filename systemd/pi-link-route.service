[Unit]
Description=pi-link Kernel Routing and Tailscale Subnet Route Keeper
After=network.target NetworkManager.service tailscaled.service
Wants=NetworkManager.service tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c "sysctl -w net.ipv4.ip_forward=1 && if command -v iptables >/dev/null 2>&1; then iptables -t nat -C POSTROUTING -s 192.168.4.0/24 -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s 192.168.4.0/24 -j MASQUERADE; fi"

[Install]
WantedBy=multi-user.target
